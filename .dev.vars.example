# Copy to .dev.vars for local development. Never commit a real .dev.vars file.
AUTH_SECRET=replace-with-a-random-32-byte-or-longer-secret
DATA_ENCRYPTION_KEY=base64url-encoded-32-byte-key-for-aes-gcm
APP_ORIGIN=http://localhost:8787
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
RESEND_API_KEY=re_replace_me
RESEND_FROM=Legacy School <onboarding@example.com>
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback
# Optional but recommended for a personal-account pilot: only this verified account may connect Google.
GOOGLE_OAUTH_ALLOWED_EMAIL=school-google-account@example.com
