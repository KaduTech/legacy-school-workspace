{
  "name": "legacy-school-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test tests/*.test.js",
    "lint": "node --check src/worker.js && node --check public/app.js && node --check scripts/security-scan.mjs",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply legacy-school --local",
    "db:migrate:remote": "wrangler d1 migrations apply legacy-school --remote",
    "security:scan": "node scripts/security-scan.mjs",
    "security:scan:live": "node scripts/security-scan.mjs --live",
    "security:scan:ci": "node scripts/security-scan.mjs --fail-on=high",
    "security:scan:weekly": "node scripts/security-scan.mjs --live --email --fail-on=high"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
